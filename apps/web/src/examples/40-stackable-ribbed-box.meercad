{
 "format": "meercad/1",
 "params": {
  "din": "5",
  "smallest": "6",
  "play": "1 mm",
  "paper_long": "1000 mm * 2 ^ (0.25 - din / 2)",
  "paper_short": "1000 mm * 2 ^ (-0.25 - din / 2)",
  "margin": "2 * (play + (corner - wall) * (1 - sqrt(0.5)) + wall + band)",
  "steps": "smallest - din",
  "width": "paper_long + margin * 2 ^ ceil(steps / 2) - 2 * band",
  "depth": "paper_short + margin * 2 ^ floor(steps / 2) - 2 * band",
  "height": "100 mm",
  "wall": "2.4 mm",
  "corner": "8 mm",
  "foot": "5 mm",
  "clearance": "0.4 mm",
  "handle_len": "min(depth * 0.5, 90 mm)",
  "handle_h": "24 mm",
  "grip_bridge": "min(30 mm, handle_len / 2)",
  "grip_rise": "(handle_len - grip_bridge) / 2 + (sqrt(2) - 1) * handle_h / 2",
  "grip_top": "height - lip_h - frame - 1 mm",
  "grip_side": "grip_top - grip_rise",
  "grip_bottom": "grip_side - handle_h / 2",
  "band": "1 mm",
  "lip_h": "4 mm",
  "plinth_h": "6 mm",
  "frame": "5 mm"
 },
 "features": [
  {
   "id": "pl1",
