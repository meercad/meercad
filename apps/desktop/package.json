{
  "name": "meercad-desktop",
  "productName": "meerCAD",
  "version": "0.1.0",
  "private": true,
  "description": "Free, source-available parametric CAD",
  "author": "meerCAD contributors",
  "license": "FSL-1.1-ALv2",
  "main": "dist/main.cjs",
  "scripts": {
    "build:main": "node build.mjs",
    "dev": "node build.mjs && electron . --dev",
    "start": "node build.mjs && electron .",
    "package": "pnpm --filter @meercad/web build && pnpm --filter @meercad/mcp build && node build.mjs && electron-builder --mac --dir",
    "dist": "pnpm --filter @meercad/web build && pnpm --filter @meercad/mcp build && node build.mjs && electron-builder --mac --publish never",
    "typecheck": "tsc --noEmit -p ."
  },
  "build": {
    "appId": "dev.meercad.app",
    "productName": "meerCAD",
    "copyright": "meerCAD contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../../packages/mcp/dist/server.js",
        "to": "mcp/server.js"
      },
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../../licenses",
        "to": "licenses"
      }
    ],
    "fileAssociations": [
      {
        "ext": "meercad",
        "name": "meerCAD part",
        "description": "meerCAD parametric part",
        "role": "Editor",
        "mimeType": "application/vnd.meercad+json"
      },
      {
        "ext": "leocad",
        "name": "meerCAD part (older format)",
        "description": "Part from an earlier version, opened and converted by meerCAD",
        "role": "Editor"
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "meercad-${version}-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "icon": "build/icon.png",
      "identity": "-",
      "notarize": false
    },
    "dmg": {
      "title": "meerCAD ${version}"
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2"
  }
}
