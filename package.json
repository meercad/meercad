{
  "name": "meercad",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @meercad/web dev",
    "ios": "pnpm --filter meercad-ios sync && pnpm --filter meercad-ios open",
    "build": "pnpm --filter @meercad/web build",
    "typecheck": "pnpm -r --parallel typecheck && tsc --noEmit -p tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config tests/e2e/vitest.config.ts",
    "wip": "node scripts/install-wip.mjs",
    "testflight": "node scripts/testflight.mjs",
    "mas": "node scripts/mas.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
