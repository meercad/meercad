{
  "name": "meercad",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @meercad/web dev",
    "ios": "pnpm --filter meercad-ios sync && pnpm --filter meercad-ios open",
    "build": "pnpm --filter @meercad/web build",
    "typecheck": "pnpm -r --parallel typecheck && tsc --noEmit -p tests",
    "test": "vitest run --project unit --project integration --project integration-slow",
    "test:quick": "vitest run --project unit --project integration",
    "test:perf": "vitest run --project perf",
    "test:release": "node scripts/test-release.mjs",
    "test:watch": "vitest --project unit --project integration",
    "test:e2e": "vitest run --config tests/e2e/vitest.config.ts",
    "test:ios": "node scripts/test-ios.mjs",
    "wip": "node scripts/install-mac.mjs wip",
    "rc": "node scripts/install-mac.mjs rc",
    "claude-config": "node scripts/claude-config.mjs",
    "testflight": "node scripts/testflight.mjs",
    "mas": "node scripts/mas.mjs",
    "hooks": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
